<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Suppress platform warnings from the original Windows-targeted DLL -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- Dependencies -->
  <ItemGroup>
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="3.7.*" />
    <PackageReference Include="protobuf-net" Version="3.2.16" />
    <PackageReference Include="protobuf-net.Core" Version="3.2.16" />
  </ItemGroup>

  <!-- Local SteamKit2 reference -->
  <ItemGroup>
    <Reference Include="SteamKit2">
      <HintPath>SteamKit2.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>